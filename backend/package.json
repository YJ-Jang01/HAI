{
  "name": "hai-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed:amazon": "tsx src/scripts/seed-amazon.ts",
    "db:backup:supabase": "powershell -ExecutionPolicy Bypass -File scripts/backup-supabase-full.ps1",
    "db:backup:rows": "tsx scripts/backup-supabase-rows.ts",
    "db:verify:amazon": "tsx scripts/verify-amazon-2023-db.ts",
    "db:verify:amazon:v3": "tsx scripts/verify-amazon-v3-db.ts",
    "db:verify:amazon2023": "tsx scripts/verify-amazon-2023-db.ts",
    "db:prune-images:amazon2023": "tsx scripts/prune-amazon-2023-images.ts",
    "search:test:amazon": "tsx scripts/test-amazon-search-queries.ts",
    "nl:test:amazon": "tsx scripts/test-amazon-natural-language-queries.ts",
    "ai:qa:amazon": "tsx scripts/test-amazon-ai-edge-flows.ts",
    "ai:qa:amazon2023": "tsx scripts/test-amazon2023-ai-flows.ts",
    "clarification:qa:amazon2023": "tsx scripts/test-amazon2023-clarification-counts.ts",
    "dataset:plan:amazon2023": "tsx scripts/plan-amazon-2023-seed.ts",
    "dataset:profile:amazon2023": "tsx scripts/profile-amazon-2023.ts",
    "dataset:import:amazon2023": "tsx scripts/import-amazon-2023.ts",
    "dataset:images:amazon2023": "tsx scripts/check-amazon-2023-images.ts",
    "dataset:fallbacks:amazon2023": "tsx scripts/export-amazon-2023-fallback-candidates.ts",
    "dataset:upload-fallbacks:amazon2023": "tsx scripts/upload-amazon-2023-fallback-thumbnails.ts",
    "dataset:purge-no-review:amazon2023": "tsx scripts/purge-amazon-2023-products-without-reviews.ts",
    "dataset:semantic:schema:amazon2023": "tsx scripts/apply-amazon-2023-semantic-schema.ts",
    "dataset:semantic:amazon2023": "tsx scripts/enrich-amazon-2023-semantics.ts",
    "query:evaluate:amazon": "tsx scripts/evaluate-amazon-query-corpus.ts",
    "query:test:amazon": "tsx scripts/evaluate-amazon-query-corpus.ts --api",
    "query:evaluate:amazon2023-llm": "tsx scripts/evaluate-amazon2023-llm-decomposition.ts",
    "db:setup:amazon": "pnpm run db:migrate && pnpm run db:seed:amazon"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
