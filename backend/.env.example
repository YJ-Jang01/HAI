PORT=8002
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173,http://127.0.0.1:5173

# Supabase Postgres connection string. Do not commit real credentials.
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_SSL=true

# Optional: enables Gemini-backed AI Criteria Lens query decomposition.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AI_AMAZON2023_LLM=on
AI_AMAZON2023_LLM_TIMEOUT_MS=4500
